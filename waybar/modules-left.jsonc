{
	"hyprland/workspaces": {
		// TODO: Better Workspace Labels. 
	},
	"network": {
		"interface": "wlan0",
		"format": "",
		"format-wifi": "{icon} {essid}",
		"format-icons": [
			"󰤯",
			"󰤟",
			"󰤢",
			"󰤥",
			"󰤨",
		],
		"format-disconnected": "󰤮",
		"on-click": "alacritty -e iwctl",
	},
	"custom/mpd": {
		"format": "  󰎆  {}  ",
		"interval": 1,
		"exec": "~/.config/waybar/mpd.fish",
		"execif": "pgrep mpd",
		"on-click": "mpc toggle",
		"on-click-right": "sonata" // unsure if i want to use this or smth else longterm 
	},
	//TODO: Configure PulseAudio Module(s)
	"pulseaudio": {
		"format-muted": "󰝟",
		"format": "󰖀 {volume}%",
		"format-bluetooth": "󰖀 {volume}% 󰂯",
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
	}
}
